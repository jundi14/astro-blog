---
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../../config/i18n';
import { entryDate, formatDate, localizedEntryPath } from '../../lib/content/entries';
import { useTranslations } from '../../i18n/utils';

interface Props {
  subposts: Array<CollectionEntry<'posts'>>;
  locale: Locale;
}

const { subposts, locale } = Astro.props;
const t = useTranslations(locale);
---

{
  subposts.length > 0 && (
    <section class="mb-12" aria-labelledby="subpost-list-title">
      <div class="mb-4 flex items-end justify-between gap-4">
        <h2 id="subpost-list-title" class="text-step-1 font-semibold">
          {t('subpost.chapters')}
        </h2>
        <span class="text-step--1 text-fg-muted tabular-nums">
          {subposts.length} {t('subpost.chapterCount')}
        </span>
      </div>

      <ol class="divide-y divide-border overflow-hidden rounded-base border border-border bg-canvas">
        {subposts.map((subpost, index) => {
          const date = entryDate(subpost);
          return (
            <li>
              <a
                href={localizedEntryPath('posts', subpost)}
                class="group grid gap-3 p-4 transition-colors duration-200 hover:bg-hover focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-accent motion-reduce:transition-none sm:grid-cols-[3rem_minmax(0,1fr)_auto] sm:items-center sm:p-5"
              >
                <span class="text-step--1 font-semibold text-fg-muted tabular-nums group-hover:text-accent-text">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span class="min-w-0">
                  <strong class="block font-medium text-fg group-hover:text-accent-text">
                    {subpost.data.title}
                  </strong>
                  {subpost.data.description && (
                    <span class="mt-1 line-clamp-2 block text-step--1 leading-relaxed text-fg-muted">
                      {subpost.data.description}
                    </span>
                  )}
                </span>
                <span class="flex items-center gap-2 text-xs text-fg-muted">
                  <time datetime={date.toISOString()}>{formatDate(date, locale)}</time>
                  <Icon
                    name="lucide:arrow-right"
                    class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-1 motion-reduce:transition-none"
                  />
                </span>
              </a>
            </li>
          );
        })}
      </ol>
    </section>
  )
}
