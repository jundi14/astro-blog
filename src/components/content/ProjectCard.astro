---
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const tags = entry.data.tags.slice(0, 3);
const github = Object.entries(entry.data.links).find(
  ([key]) => key.trim().toLowerCase() === 'github'
)?.[1];
---

<article class="flex h-full flex-col rounded-base border border-border bg-canvas p-5">
  <div class="flex items-start justify-between gap-3">
    <h2 class="text-step-0 leading-snug font-semibold">{entry.data.title}</h2>
    {
      github && (
        <a
          href={github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${entry.data.title}: GitHub`}
          title="GitHub"
          class="project-github inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-base focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          <Icon name="simple-icons:github" class="h-4 w-4" />
        </a>
      )
    }
  </div>
  {
    entry.data.description && (
      <p class="mt-2 line-clamp-3 text-step--1 leading-relaxed text-fg-muted">
        {entry.data.description}
      </p>
    )
  }

  {
    tags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <span class="rounded-full bg-muted px-2.5 py-0.5 text-xs text-fg-muted">#{tag}</span>
        ))}
      </div>
    )
  }
</article>
