---
import { Icon } from 'astro-icon/components';
import type { Locale } from '../../config/i18n';
import type { TocSubposts } from '../features/TocPanel.astro';
import { useTranslations } from '../../i18n/utils';

export interface Crumb {
  label: string;
  href?: string;
  icon?: string;
}

interface Props {
  locale: Locale;
  items: Crumb[];
  title: string;
  subposts?: TocSubposts;
}

const { locale, items, title, subposts } = Astro.props;
const t = useTranslations(locale);
const crumbs = [...items, { label: title }];
const currentIndex = subposts ? subposts.items.findIndex((item) => item.current) : -1;
const previous = subposts && currentIndex > 0 ? subposts.items[currentIndex - 1] : undefined;
const next =
  subposts && currentIndex >= 0 && currentIndex < subposts.items.length - 1
    ? subposts.items[currentIndex + 1]
    : undefined;
const badge =
  subposts && subposts.total > 0
    ? subposts.position > 0
      ? `${subposts.position}/${subposts.total}`
      : String(subposts.total)
    : '';
---

<header id="context-bar" data-collapsed="false" data-ready="false">
  <div class="context-shell glass">
    <div class="context-top">
      <nav class="context-crumbs" aria-label={t('nav.breadcrumb')}>
        <ol class="crumb-trail">
          {
            crumbs.map((item, index) => (
              <li class="crumb-node">
                {index > 0 && (
                  <span class="crumb-sep" aria-hidden="true">
                    <Icon name="lucide:chevron-right" class="h-3.5 w-3.5" />
                  </span>
                )}
                {index === crumbs.length - 1 || !item.href ? (
                  <span
                    class="crumb-current"
                    aria-current={index === crumbs.length - 1 ? 'page' : undefined}
                    title={item.label}
                  >
                    <span class="crumb-label">{item.label}</span>
                  </span>
                ) : (
                  <a
                    href={item.href}
                    class="crumb"
                    title={item.label}
                    aria-label={index === 0 ? item.label : undefined}
                  >
                    {item.icon ? (
                      <Icon name={item.icon} class="h-3.5 w-3.5 shrink-0" />
                    ) : null}
                    <span class="crumb-label">{item.label}</span>
                  </a>
                )}
              </li>
            ))
          }
        </ol>
      </nav>

      <button
        id="context-pill"
        type="button"
        class="context-pill"
        aria-label={`${t('nav.breadcrumb')}: ${title}`}
        title={title}
      >
        <span class="context-pill-title">{title}</span>
        {badge && <span class="context-pill-badge tabular-nums">{badge}</span>}
      </button>
    </div>

    {
      subposts && (
        <div class="subpost-bar">
          <button
            type="button"
            class="subpost-trigger"
            data-subpost-toggle
            aria-expanded="false"
            aria-controls="subpost-popover"
            aria-label={`${t('subpost.label')}: ${subposts.title}`}
          >
            <span class="text-accent-text shrink-0">
              <Icon name="lucide:layers" class="h-4 w-4" />
            </span>
            <span class="subpost-trigger-title">{subposts.title}</span>
            {badge && <span class="subpost-trigger-badge tabular-nums">{badge}</span>}
            <span class="subpost-chevron" aria-hidden="true">
              <Icon name="lucide:chevron-down" class="h-4 w-4" />
            </span>
          </button>

          <ol class="subpost-steps" aria-label={subposts.title}>
            {subposts.items.map((item, index) => (
              <li class="subpost-step-item">
                {index > 0 && (
                  <span
                    class:list={[
                      'subpost-step-line',
                      index <= subposts.position && 'subpost-step-line-active'
                    ]}
                    aria-hidden="true"
                  />
                )}
                <a
                  href={item.href}
                  class:list={[
                    'subpost-dot',
                    item.current && 'subpost-dot-current',
                    !item.current && index < currentIndex && 'subpost-dot-past'
                  ]}
                  aria-current={item.current ? 'page' : undefined}
                  aria-label={`${index}. ${item.title}`}
                  title={item.title}
                >
                  <span>{index}</span>
                </a>
              </li>
            ))}
          </ol>

          <div class="subpost-actions">
            {previous ? (
              <a
                href={previous.href}
                class="subpost-step"
                aria-label={t('subpost.previousChapter')}
                title={`${t('subpost.previousChapter')}: ${previous.title}`}
              >
                <Icon name="lucide:chevron-left" class="h-4 w-4" />
              </a>
            ) : (
              <span class="subpost-step" aria-disabled="true">
                <Icon name="lucide:chevron-left" class="h-4 w-4" />
              </span>
            )}
            {next ? (
              <a
                href={next.href}
                class="subpost-step"
                aria-label={t('subpost.nextChapter')}
                title={`${t('subpost.nextChapter')}: ${next.title}`}
              >
                <Icon name="lucide:chevron-right" class="h-4 w-4" />
              </a>
            ) : (
              <span class="subpost-step" aria-disabled="true">
                <Icon name="lucide:chevron-right" class="h-4 w-4" />
              </span>
            )}
          </div>
        </div>
      )
    }
  </div>

  {
    subposts && (
      <div id="subpost-popover" class="context-popover glass" hidden>
        <div class="subpost-popover-head">
          <span class="truncate text-xs font-semibold text-fg">{subposts.title}</span>
          <a
            href={subposts.href}
            class="text-fg-muted transition-colors hover:text-fg inline-flex shrink-0 items-center gap-1 text-xs"
          >
            <span>{t('subpost.label')}</span>
            <Icon name="lucide:arrow-right" class="h-3.5 w-3.5" />
          </a>
        </div>
        <ol class="subpost-popover-list">
          {subposts.items.map((item, index) => (
            <li>
              <a
                href={item.href}
                class="subpost-popover-item"
                aria-current={item.current ? 'page' : undefined}
              >
                <span class="subpost-popover-index">{index}</span>
                <span class="truncate">{item.title}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    )
  }
</header>

<script>
  import '../../scripts/context-bar.ts';
</script>
