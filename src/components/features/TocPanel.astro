---
export interface TocHeading {
  depth: number;
  slug: string;
  text: string;
}

export interface TocSubpostItem {
  title: string;
  href: string;
  current: boolean;
  /** 0 is the parent entry, 1..N are the chapters. */
  position: number;
}

export interface TocSubposts {
  title: string;
  href: string;
  position: number;
  total: number;
  items: TocSubpostItem[];
}

interface Props {
  headings: TocHeading[];
  subposts?: TocSubposts;
}

const { headings, subposts } = Astro.props;
const indent = (depth: number) => `padding-left: ${(depth - 2) * 0.85 + 0.5}rem`;
---

{
  subposts ? (
    <div>
      <a
        href={subposts.href}
        class="flex items-center justify-between gap-2 rounded-xs px-2 py-1.5 text-step--1 font-semibold text-fg transition-colors hover:bg-hover"
      >
        <span class="truncate">{subposts.title}</span>
        <span class="shrink-0 text-xs text-fg-muted tabular-nums">
          {subposts.position > 0 ? `${subposts.position}/${subposts.total}` : subposts.total}
        </span>
      </a>
      <ol class="mt-1 space-y-0.5 border-t border-border pt-1">
        {subposts.items.map((item) => (
          <li>
            {item.current ? (
              <>
                <span
                  aria-current="true"
                  class="flex items-baseline gap-2 rounded-xs bg-hover px-2 py-1.5 text-step--1 font-semibold text-fg"
                >
                  <span class="w-4 shrink-0 text-right text-xs text-fg-muted tabular-nums">
                    {item.position}
                  </span>
                  <span class="truncate">{item.title}</span>
                </span>
                {headings.length > 0 && (
                  <div data-toc-subtree class="my-1 ml-4 border-l border-border pl-1.5">
                    {headings.map((heading) => (
                      <a
                        href={`#${heading.slug}`}
                        data-toc-link
                        data-depth={heading.depth}
                        class="block truncate rounded-xs px-2 py-1.5 text-step--1 text-fg-muted transition-colors hover:bg-hover hover:text-fg"
                        style={indent(heading.depth)}
                      >
                        {heading.text}
                      </a>
                    ))}
                  </div>
                )}
              </>
            ) : (
              <a
                href={item.href}
                class="flex items-baseline gap-2 rounded-xs px-2 py-1.5 text-step--1 text-fg-muted transition-colors hover:bg-hover hover:text-fg"
              >
                <span class="w-4 shrink-0 text-right text-xs tabular-nums">
                  {item.position}
                </span>
                <span class="truncate">{item.title}</span>
              </a>
            )}
          </li>
        ))}
      </ol>
    </div>
  ) : (
    <div>
      {headings.map((heading) => (
        <a
          href={`#${heading.slug}`}
          data-toc-link
          data-depth={heading.depth}
          class="block truncate rounded-xs px-2 py-1.5 text-step--1 text-fg-muted transition-colors hover:bg-hover hover:text-fg"
          style={indent(heading.depth)}
        >
          {heading.text}
        </a>
      ))}
    </div>
  )
}
